<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>App1</RootNamespace>
    <ApplicationTitle>App1</ApplicationTitle>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250870001" />
    <PackageReference Include="Plugin.WinUI.MVVMExpress" Version="$(WinUIMvvmExpressVersion)" />
    <PackageReference Include="Plugin.WinUI.MVVMExpress.Dialogs" Version="$(WinUIMvvmExpressVersion)" />
    <PackageReference Include="Plugin.WinUI.MVVMExpress.Navigation" Version="$(WinUIMvvmExpressVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App1.Core\App1.Core.csproj" />
  </ItemGroup>

</Project>
