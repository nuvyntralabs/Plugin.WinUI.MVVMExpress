<Page
    x:Class="App1.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="24" MaxWidth="360" Spacing="8">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Sign in" />
    <TextBlock Text="demo@mvvmexpress.dev / secret" />
    <TextBox Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <PasswordBox x:Name="PasswordBox" />
    <Button Content="Sign in" Command="{Binding SignInCommand}" Click="OnSignIn" />
  </StackPanel>
</Page>
