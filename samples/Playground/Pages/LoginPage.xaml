<Page
    x:Class="Plugin.WinUI.MVVMExpress.Playground.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="24" MaxWidth="360">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Sign in" />
    <TextBlock Margin="0,8,0,16" Text="demo@mvvmexpress.dev / secret" />
    <TextBox Text="{{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}}" />
    <PasswordBox Margin="0,8,0,16" x:Name="PasswordBox" />
    <Button Content="Sign in" Command="{{Binding SignInCommand}}" Click="OnSignIn" />
  </StackPanel>
</Page>
